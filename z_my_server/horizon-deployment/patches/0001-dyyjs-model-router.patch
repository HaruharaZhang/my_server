diff --git a/tests/test_model_router.py b/tests/test_model_router.py
new file mode 100644
index 0000000..fb57849
--- /dev/null
+++ b/tests/test_model_router.py
@@ -0,0 +1,160 @@
+"""Tests for the same-endpoint model priority router."""
+
+import asyncio
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from src.ai.client import OpenAIClient
+from src.models import AIConfig, AIProvider
+
+
+class _Models:
+    def __init__(self, result=None, error=None):
+        self.result = result or []
+        self.error = error
+        self.calls = 0
+
+    async def list(self):
+        self.calls += 1
+        if self.error:
+            raise self.error
+        return SimpleNamespace(data=[SimpleNamespace(id=name) for name in self.result])
+
+
+def _router(priority=("m1", "m2"), remote=("m1", "m2")):
+    router = object.__new__(OpenAIClient)
+    router.config = SimpleNamespace()
+    router.client = SimpleNamespace(models=_Models(remote))
+    router.model = priority[0]
+    router.provider = "ali"
+    router._routing_enabled = True
+    router._model_priority = list(priority)
+    router._available_models = None
+    router._disabled_models = set()
+    router._models_used = []
+    router._model_init_lock = asyncio.Lock()
+    return router
+
+
+def test_model_priority_intersects_in_configured_order():
+    router = _router(("m1", "m2", "m3"), ("m3", "m1"))
+    assert asyncio.run(router._get_available_models()) == ["m1", "m3"]
+
+
+def test_model_list_failure_retains_configured_models():
+    router = _router()
+    router.client.models = _Models(error=RuntimeError("unavailable"))
+    assert asyncio.run(router._get_available_models()) == ["m1", "m2"]
+
+
+def test_no_matching_model_fails_explicitly():
+    router = _router(("m1",), ("other",))
+    with pytest.raises(RuntimeError, match="None of the configured"):
+        asyncio.run(router._get_available_models())
+
+
+def test_concurrent_initialization_lists_models_once():
+    router = _router()
+
+    async def run():
+        return await asyncio.gather(*(router._get_available_models() for _ in range(8)))
+
+    results = asyncio.run(run())
+    assert all(result == ["m1", "m2"] for result in results)
+    assert router.client.models.calls == 1
+
+
+def test_single_model_config_is_backward_compatible(monkeypatch):
+    monkeypatch.setenv("DASHSCOPE_API_KEY", "test-only")
+    config = AIConfig(
+        provider=AIProvider.ALI,
+        model="qwen-plus",
+        api_key_env="DASHSCOPE_API_KEY",
+    )
+    client = OpenAIClient(config)
+    assert client._model_priority == ["qwen-plus"]
+    assert client._routing_enabled is False
+    assert asyncio.run(client._get_available_models()) == ["qwen-plus"]
+    asyncio.run(client._http_client.aclose())
+
+
+def test_openai_client_disables_sdk_retries_and_environment_proxy(monkeypatch):
+    captured = {}
+
+    class FakeAsyncOpenAI:
+        def __init__(self, **kwargs):
+            captured.update(kwargs)
+
+    monkeypatch.setenv("DASHSCOPE_API_KEY", "test-only")
+    monkeypatch.setattr("src.ai.client.AsyncOpenAI", FakeAsyncOpenAI)
+    client = OpenAIClient(
+        AIConfig(
+            provider=AIProvider.ALI,
+            model="m1",
+            api_key_env="DASHSCOPE_API_KEY",
+        )
+    )
+    assert captured["max_retries"] == 0
+    assert captured["timeout"] == 180.0
+    transport = captured["http_client"]._transport
+    assert isinstance(transport, httpx.AsyncHTTPTransport)
+    assert not hasattr(transport, "_pool") or transport._pool._proxy is None
+    asyncio.run(client._http_client.aclose())
+
+
+def test_ordinary_error_retries_once_then_falls_back():
+    router = _router()
+    calls = []
+
+    async def complete_once(*_args):
+        calls.append(router.model)
+        if router.model == "m1":
+            raise RuntimeError("temporary")
+        return "ok"
+
+    router._complete_once = complete_once
+    assert asyncio.run(router.complete("system", "user", 0.2, 100)) == "ok"
+    assert calls == ["m1", "m1", "m2"]
+    assert router.models_used == ["m2"]
+
+
+def test_429_disables_model_without_retry_and_falls_back():
+    router = _router()
+    calls = []
+
+    async def complete_once(*_args):
+        calls.append(router.model)
+        if router.model == "m1":
+            error = RuntimeError("rate limited")
+            error.status_code = 429
+            raise error
+        return "ok"
+
+    router._complete_once = complete_once
+    assert asyncio.run(router.complete("system", "user", 0.2, 100)) == "ok"
+    assert calls == ["m1", "m2"]
+    assert router._disabled_models == {"m1"}
+
+
+def test_usage_and_json_constraints_are_preserved():
+    router = _router(("m1",), ("m1",))
+    router.temperature = 0.3
+    router.max_tokens = 4096
+    router._supports_temperature = True
+    router._use_max_completion_tokens = False
+    captured = {}
+
+    async def create(**kwargs):
+        captured.update(kwargs)
+        usage = SimpleNamespace(prompt_tokens=3, completion_tokens=2)
+        choice = SimpleNamespace(message=SimpleNamespace(content='{"ok": true}'))
+        return SimpleNamespace(usage=usage, choices=[choice])
+
+    router.client.chat = SimpleNamespace(
+        completions=SimpleNamespace(create=create)
+    )
+    result = asyncio.run(router.complete("system", "user"))
+    assert result == '{"ok": true}'
+    assert captured["response_format"] == {"type": "json_object"}

