[Unit]
Description=dyyjs.com Bilibili playback relay (FastAPI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dyyjs-bilibili/app
EnvironmentFile=/etc/dyyjs-bilibili/env
ExecStart=/opt/dyyjs-bilibili/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8091 --no-access-log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
