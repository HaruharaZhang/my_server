[Unit]
Description=bgutil-ytdlp-pot-provider server (YouTube PO Token provider for yt-dlp)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dyyjs-youtube/pot-provider/server
ExecStart=/opt/dyyjs-youtube/node24-runtime/bin/node /opt/dyyjs-youtube/pot-provider/server/build/main.js --port 4416
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
