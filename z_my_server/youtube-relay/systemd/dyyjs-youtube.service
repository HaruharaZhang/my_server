[Unit]
Description=dyyjs.com YouTube playback relay (FastAPI)
Wants=network-online.target dyyjs-youtube-pot.service
After=network-online.target dyyjs-youtube-pot.service

[Service]
Type=simple
WorkingDirectory=/opt/dyyjs-youtube/app
EnvironmentFile=/etc/dyyjs-youtube/env
ExecStart=/opt/dyyjs-youtube/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8090 --no-access-log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
